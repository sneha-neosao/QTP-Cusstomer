<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <LinearLayout
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10dp"
            >
    <LinearLayout
        android:id="@+id/ll_nav_title"
        android:visibility="visible"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        android:background="@drawable/solid_bg_gray"
       >

        <EditText
            android:id="@+id/edt_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="5dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:drawablePadding="5dp"
            app:fontFamily="@font/montserrat_semi_bold"
            android:background="@android:color/transparent"
            android:textColorHint="#324763"
            android:hint="What are you looking for?"
            android:drawableTint="@color/darkGrey"
            android:drawableLeft="@drawable/ic_baseline_search_24"
            android:textColor="@color/black"
            android:singleLine="true"
            android:textSize="10sp"
            />
    </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_gravity="center"
            app:fontFamily="@font/montserrat_medium"
            android:textColor="#000000"
            android:visibility="gone"
            android:textSize="12sp"
            />

    </LinearLayout>

            <!--Recent Searches-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/llRecentSearch"
                android:visibility="gone"
                android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Searches"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                app:fontFamily="@font/montserrat_semi_bold"
                android:textSize="14sp"
                android:textColor="@color/black"

                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="22dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:nestedScrollingEnabled="false"
                android:id="@+id/recyclerSearch"
                android:layout_margin="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            </LinearLayout>

            <!--Recommendations-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="34dp"
                android:id="@+id/llRecommendations">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:backgroundTint="@color/aqua"
                        android:background="@drawable/solid_bg_half_rounded"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:text="                "
                        android:layout_marginLeft="-20dp"
                        android:layout_centerVertical="true"
                        android:textColor="@color/black"

                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="180dp"
                        android:layout_marginBottom="10dp"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:text="*  Recommended  *"
                        android:rotation="-90"
                        app:fontFamily="@font/montserrat_semi_bold"
                        android:layout_centerInParent="true"
                        android:layout_marginLeft="-150dp"
                        android:layout_centerVertical="true"
                        android:textColor="@color/white"
                        android:padding="10dp"
                        tools:ignore="HardcodedText" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recommended"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    />

            </LinearLayout>

            <!--Feature Products-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvFeatureProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="10dp"
                android:elevation="8dp"
                app:cardElevation="8dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                   >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feature Products"
                        android:layout_marginLeft="22dp"
                        android:layout_marginTop="17dp"
                        android:layout_marginBottom="16dp"
                        app:fontFamily="@font/montserrat_semi_bold"
                        android:textSize="14sp"
                        android:textColor="@color/black"

                        />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:background="@color/white"
                        android:layout_marginBottom="72dp"
                        android:gravity="center">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_image_slider"
                            android:layout_width="match_parent"
                            android:layout_height="190dp" />

                    </LinearLayout>

                </LinearLayout>



            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>