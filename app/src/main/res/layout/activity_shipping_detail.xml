<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="activities.ShippingDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                app:layout_scrollFlags="scroll|enterAlways"
                android:id="@+id/ll1"
                android:layout_width="match_parent"
                android:layout_height="?actionBarSize"
                android:background="#324764"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/llBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="8dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:layout_gravity="start|center_vertical">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/ic_left_arrow"
                    android:backgroundTint="@color/white"
                    />
                </LinearLayout>

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="32dp"
                    android:layout_height="34dp"
                    android:src="@drawable/qtp_logo_new_1"
                    android:layout_marginStart="45dp"
                    android:layout_gravity="center_vertical"
                    />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginRight="10dp"
                    android:fontFamily="@font/montserrat_semibold"
                    android:gravity="center"
                    android:text="Shipping"
                    android:textColor="@color/white"
                    android:textSize="20sp" />


            </androidx.coordinatorlayout.widget.CoordinatorLayout>


        </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/order_stage_1"
                    android:layout_gravity="center"
                    />

                    <TextView
                        android:id="@+id/tvShippingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shipping"
                        android:textSize="8sp"
                        android:layout_gravity="center"
                        android:textColor="@color/colorPrimary"
                        android:fontFamily="@font/montserrat_medium"/>

                </LinearLayout>

                <View
                    android:id="@+id/view_stage1"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="5dp"
                    android:backgroundTint="@color/mediumGrey"
                    android:background="@drawable/dash_bg"
                    android:layout_gravity="center"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                <ImageView
                    android:id="@+id/img_offer"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/order_stage_2"
                    />
                <TextView
                    android:id="@+id/tvOfferLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offer"
                    android:layout_gravity="center"
                    android:textSize="8sp"
                    android:fontFamily="@font/montserrat_medium"/>
                </LinearLayout>

                <View
                    android:id="@+id/view_stage2"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="5dp"
                    android:backgroundTint="@color/mediumGrey"
                    android:background="@drawable/dash_bg"
                    android:layout_gravity="center"
                    />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <ImageView
                    android:id="@+id/img_payment"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                            android:layout_gravity="center"
                    android:src="@drawable/order_stage_3"
                    />
                        <TextView
                            android:id="@+id/tvPaymentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment"
                    android:textSize="8sp"
                            android:layout_gravity="center"
                    android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                <View
                    android:id="@+id/view_stage3"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="5dp"
                    android:backgroundTint="@color/mediumGrey"
                    android:background="@drawable/dash_bg"
                    android:layout_gravity="center"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/img_place_order"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/order_stage_4"/>
                    <TextView
                        android:id="@+id/tvPlaceOrderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Place Order"
                    android:textSize="8sp"
                        android:layout_gravity="center"
                    android:fontFamily="@font/montserrat_medium"/>
                        </LinearLayout>

            </LinearLayout>

           <!-- <include layout="@layout/layout_product_add_new"/>-->

            <!--1-->
            <LinearLayout
            android:id="@+id/ll_stage_1"
            android:animateLayoutChanges="true"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:id="@+id/rv_address"
                tools:listitem="@layout/item_layout_address"
                />

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
            android:orientation="horizontal"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/rv_address1"
                    tools:listitem="@layout/item_layout_address"
                    />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/aqua"
                android:layout_weight="1"
                android:visibility="gone"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/white"
                        android:layout_gravity="end"
                        android:layout_margin="10dp"
                        android:src="@drawable/ic_edit"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="@color/white"
                        style="@style/boldFont"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="18dp"
                        android:layout_marginTop="5dp"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dummy_text_3"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_margin="10dp"
                        />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:backgroundTint="@color/light_aqua2"
                android:layout_weight="1.2"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:tint="@color/darkGrey"
                        android:layout_gravity="end"
                        android:layout_margin="10dp"
                        android:src="@drawable/ic_edit"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Office"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="16dp"
                        android:layout_marginTop="5dp"
                        />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dummy_text_3"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="10sp"
                        android:layout_margin="10dp"
                        />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_new_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:elevation="8dp"
                android:backgroundTint="@color/white"
                android:text="Add New Address"
                android:textColor="@color/colorPrimary"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                />


        </LinearLayout>

            <!--2-->
            <LinearLayout
            android:id="@+id/ll_stage_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <include layout="@layout/layout_offer"/>

        </LinearLayout>

            <!--3-->
            <LinearLayout
                android:id="@+id/ll_stage_3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <include layout="@layout/layout_payment_method"/>

            </LinearLayout>

            <!--4-->
            <LinearLayout
                android:id="@+id/ll_stage_4"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <include layout="@layout/layout_place_order"/>

            </LinearLayout>


        </LinearLayout>


        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </androidx.core.widget.NestedScrollView>

    <br.com.simplepass.loadingbutton.customViews.CircularProgressButton
        android:id="@+id/btn_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/colorPrimary"
        android:text="info"
        android:visibility="gone"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="@drawable/border_rounded" />
    <!--app:spinning_bar_width="4dp" &lt;!&ndash; Optional &ndash;&gt;
    app:spinning_bar_color="#FFF" &lt;!&ndash; Optional &ndash;&gt;
    app:spinning_bar_padding="6dp"
    />-->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">



        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="10dp"
            android:elevation="8dp"
            android:visibility="gone"
            android:text="Next"
            android:gravity="center"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:layout_gravity="bottom"
            android:textSize="16sp"
            android:textStyle="bold"
            />

        <com.ncorti.slidetoact.SlideToActView
            android:id="@+id/btn_next_slide"
            android:layout_width="160dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:elevation="6dp"
            app:area_margin="5dp"
            android:visibility="gone"
            app:slider_icon="@drawable/shopping_bag"
            app:icon_margin="4dp"
            app:animation_duration="250"
            app:outer_color="#324764"
            app:inner_color="@color/white"
            app:text="Next"
            app:text_size="15sp"
            android:layout_alignParentBottom="true"
            android:layout_margin="10dp"
            app:slider_height="30dp"
            app:slider_locked="false" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cl_next_slide"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_bg_darkbutton">


                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/ic_baseline_arrow_forward_24"
                    app:tint="#324764"
                    android:layout_gravity="start|center"
                    android:layout_marginStart="4dp"
                    android:padding="3dp"
                    android:background="@drawable/shape_bg_darkbutton"
                    android:backgroundTint="@color/white"
                    />
                <TextView
                    android:id="@+id/tvNext"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    />


        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <com.ncorti.slidetoact.SlideToActView
            android:id="@+id/btn_next_offer_slide"
            android:layout_width="160dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:elevation="6dp"
            app:area_margin="5dp"
            android:visibility="gone"
            app:slider_icon="@drawable/shopping_bag"
            app:icon_margin="4dp"
            app:animation_duration="250"
            app:outer_color="#324764"
            app:inner_color="@color/white"
            app:text="Next"
            app:text_size="15sp"
            android:layout_alignParentBottom="true"
           android:layout_margin="10dp"
            app:slider_height="30dp"
            app:slider_locked="false" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cl_next_offer_slide"
            android:layout_width="120dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:background="@drawable/shape_bg_darkbutton">


                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/ic_baseline_arrow_forward_24"
                    app:tint="#324764"
                    android:layout_gravity="start|center"
                    android:layout_marginStart="4dp"
                    android:padding="3dp"
                    android:background="@drawable/shape_bg_darkbutton"
                    android:backgroundTint="@color/white"
                    />
                <TextView
                    android:id="@+id/tvNextOffer"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <com.ncorti.slidetoact.SlideToActView
            android:id="@+id/btn_confirmOrder_slide"
            android:layout_width="180dp"
            android:layout_gravity="center"
            android:layout_height="0dp"
            android:elevation="5dp"
            app:area_margin="5dp"
            android:visibility="gone"
            app:slider_icon="@drawable/shopping_bag"
            app:icon_margin="4dp"
            app:animation_duration="250"
            app:outer_color="@color/aqua"
            app:inner_color="@color/white"
            app:text="Swipe to confirm"
            app:text_size="15sp"
            android:layout_alignParentBottom="true"
            android:layout_margin="20dp"
            app:slider_height="30dp"
            app:slider_locked="false" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cl_confirmOrder_slide"
            android:layout_width="140dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:background="@drawable/shape_bg_darkbutton"
            android:backgroundTint="@color/aqua">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/shopping_bag"
                app:tint="@color/aqua"
                android:layout_gravity="start|center"
                android:layout_marginStart="4dp"
                android:padding="3dp"
                android:background="@drawable/shape_bg_darkbutton"
                android:backgroundTint="@color/white"
                    />
                <TextView
                    android:id="@+id/tvConfirmOrder"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Place Order"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    />


        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    </LinearLayout>


    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>