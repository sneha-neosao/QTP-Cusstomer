<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F2F4">

        <RelativeLayout
            android:id="@+id/rv_shr_img"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:background="#F0F2F4">

            <ImageView
                android:id="@+id/img_sharget"
                android:layout_width="287dp"
                android:layout_height="180dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:src="@drawable/shareget_img" />

            <TextView
                android:id="@+id/txt_show_offer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/img_sharget"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txt_reDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txt_show_offer"
                android:layout_centerInParent="true"
                android:layout_marginTop="05dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="-"
                android:textColor="@color/txt_share"
                android:textSize="14sp" />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_below="@id/rv_shr_img"
            android:layout_centerInParent="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="20dp"
            android:background="@color/white"
            app:cardCornerRadius="05dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp">

                <TextView
                    android:id="@+id/txt_signup_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="35dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="0"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txt_signup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_signup_count"
                    android:layout_marginLeft="10dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Sign Ups"
                    android:textColor="@color/txt_share"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/view1"
                    android:layout_width="2px"
                    android:layout_height="55dp"
                    android:layout_marginLeft="25dp"
                    android:layout_toRightOf="@id/txt_signup"
                    android:background="@color/view_color" />

                <TextView
                    android:id="@+id/txt_order_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="38dp"
                    android:layout_toRightOf="@id/view1"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="0"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txt_orderd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_order_count"
                    android:layout_marginLeft="15dp"
                    android:layout_toRightOf="@id/view1"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Ordered"
                    android:textColor="@color/txt_share"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/view2"
                    android:layout_width="2px"
                    android:layout_height="55dp"
                    android:layout_marginLeft="20dp"
                    android:layout_toRightOf="@id/txt_orderd"
                    android:background="@color/view_color" />

                <TextView
                    android:id="@+id/txt_viewstatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="20dp"
                    android:layout_toRightOf="@id/view2"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="View Status"
                    android:textColor="@color/viewtxt_color"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/view3"
                    android:layout_width="80dp"
                    android:layout_height="1px"
                    android:layout_below="@id/txt_viewstatus"
                    android:layout_marginLeft="20dp"
                    android:layout_toRightOf="@id/view2"
                    android:background="@color/viewtxt_color" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:id="@+id/rl_refer_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardview"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="25dp">

            <ImageView
                android:id="@+id/img_steps"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:gravity="center"
                android:src="@drawable/refer_steps" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/img_steps"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:text="Invite\nFriends"
                    android:textColor="@color/txt_share"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:text="Friends\nCome Onboard"
                    android:textColor="@color/txt_share"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    android:text="Get\nRewarded"
                    android:textColor="@color/txt_share"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_refer_steps"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp">


            <TextView
                android:id="@+id/txt_invitecoe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/montserrat_bold"
                android:text="Your Invite Code"
                android:textSize="14sp"
                android:textStyle="bold" />


            <LinearLayout
                android:id="@+id/ll_tapcopy"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_below="@+id/txt_invitecoe"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="60dp"
                android:background="@drawable/refer_bg_rect_shape"
                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/txt_invitationCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="-"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_tapcopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="Tap to Copy "
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/shrcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_tapcopy"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:src="@drawable/refer_or_share_code" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_share"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_below="@id/shrcode"
                android:background="@drawable/bg_btn_rect_shape"
                android:fontFamily="@font/montserrat_medium"
                android:text="Share"
                android:textAllCaps="false"
                android:textColor="@color/txt_share"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txt_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_share"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/montserrat_medium"
                android:textStyle="bold"
                android:text="Terms  &amp; Conditions"
                android:textColor="@color/viewtxt_color"
                android:textSize="12sp" />

            <View
                android:layout_width="140dp"
                android:layout_height="2px"
                android:layout_below="@id/txt_terms"
                android:layout_centerHorizontal="true"
                android:background="@color/viewtxt_color" />

        </RelativeLayout>

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            android:background="@android:color/transparent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent">


            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.AppBarLayout>
    </RelativeLayout>
    </ScrollView>

</RelativeLayout>