<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@color/white"

                android:orientation="vertical">


                <ImageView
                    android:id="@+id/img_order_product"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_gravity="center"
                    android:scaleType="fitXY"
                    android:background="@drawable/noimageavailable"/>
            </LinearLayout>

            <ImageView
                android:src="@mipmap/ic_launcher"
                android:id="@+id/img_order_product1"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:scaleType="fitXY"/>

            <LinearLayout
                android:layout_marginLeft="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:textSize="14sp"
                    android:maxLines="2"
                    app:fontFamily="@font/montserrat_semi_bold"
                    android:textColor="#324763"
                    android:layout_marginBottom="10dp"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/txt_product_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product weight"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_medium"
                        android:layout_gravity="center"
                        android:textColor="@color/text_color"
                        />

                    <TextView
                        android:id="@+id/txt_product_quantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_medium"
                        android:textColor="@color/text_color"
                        />

                    <TextView
                        android:id="@+id/txt_product_price"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="AED 121"
                        android:textColor="@color/text_color"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_medium" />
                </LinearLayout>



            </LinearLayout>





        </LinearLayout>

        <ImageView
            android:id="@+id/ivProductFeedback"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:background="?selectableItemBackground"
            android:src="@drawable/star_4_grey" />

    </LinearLayout>


</LinearLayout>