<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/outlined_square_gray"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:orientation="vertical">

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
           android:orientation="horizontal">

           <ImageView
               android:id="@+id/img_seller_logo"
               android:layout_width="35dp"
               android:layout_height="35dp"
               android:layout_margin="5dp"
               android:elevation="4dp"
               android:src="@drawable/processing"
               />

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginLeft="5dp"
               android:layout_weight="1"
               android:orientation="vertical">

               <TextView
                   android:id="@+id/txt_seller_name"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:textSize="10sp"
                   app:fontFamily="@font/montserrat_semi_bold"
                   android:textColor="@color/orange"
                   android:layout_marginTop="5dp"
                   android:text="Suborder"
                   />

               <TextView
                   android:id="@+id/txt_seller_price"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:textSize="8sp"
                   android:fontFamily="@font/montserrat_medium"
                   android:layout_marginTop="5dp"
                   android:textColor="@color/hintColor"
                   android:text="Suborder"
                   />

           </LinearLayout>

           <TextView
               android:id="@+id/txt_order_status"
               android:layout_width="120dp"
               android:layout_height="30dp"
               android:text="Delivered"
               android:layout_gravity="top|right"
               android:background="@drawable/topright_botomleft_rounde_green_background"
               android:gravity="center"
               android:textColor="@color/white"
               android:textSize="10sp"
               app:fontFamily="@font/montserrat_medium"
               />

       </LinearLayout>

        <include layout="@layout/item_layout_order_product"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/ll_order_items"
            android:layout_margin="5dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_orderItem"
                android:nestedScrollingEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:listitem="@layout/item_layout_order_product"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_status_track"
            android:layout_margin="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="2dp"
                    android:layout_marginLeft="15dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/delivered"
                        app:civ_border_color="@color/lightGrey"
                        app:civ_border_width="5dp" />

                    <View
                        android:id="@+id/view1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:background="@color/lightGrey" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view2"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:background="@color/lightGrey" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/confirm_image"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/accepted_2"
                        />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProcessingDoneTrack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/delivered"
                        android:visibility="gone"
                        app:civ_border_color="@color/lightGrey"
                        app:civ_border_width="5dp" />

                    <View
                        android:id="@+id/view3"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:background="@color/lightGrey" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view4"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:background="@color/lightGrey" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/otw_image"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/delivered_3"
                        />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivOTWDoneTrack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/delivered"
                        android:visibility="gone"
                        app:civ_border_color="@color/lightGrey"
                        app:civ_border_width="5dp" />

                    <View
                        android:id="@+id/view5"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:background="@color/lightGrey" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view6"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:background="@color/lightGrey" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/delivered_image"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/delivered_4" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivDeliveredDoneTrack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/delivered"
                        android:visibility="gone"
                        app:civ_border_color="@color/lightGrey"
                        app:civ_border_width="5dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_marginStart="15dp"
                android:layout_marginEnd="5dp"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"
                    android:layout_marginLeft="5dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Pending"
                        android:textSize="10sp"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"/>

                    <TextView
                        android:text="Accepted"
                        android:includeFontPadding="false"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="3dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        />

                    <TextView
                        android:text="On the way"
                        android:includeFontPadding="false"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="3dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_gravity="bottom"
                    android:gravity="bottom"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        />
                    <TextView
                        android:text="Delivered"
                        android:includeFontPadding="false"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:backgroundTint="@color/lightGrey"
            android:background="@drawable/dash_bg"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>