<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_gravity="bottom"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        >
        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            app:cardElevation="8dp"
            app:cardCornerRadius="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="-10dp"
            >
            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:orientation="vertical">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How was the delivery experience?"
            android:textColor="@color/black"
            android:layout_gravity="center"
            app:fontFamily="@font/montserrat_semi_bold"
            android:textSize="18sp"
            android:layout_marginBottom="55dp"
            android:layout_marginTop="17dp"
            />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/edtFeedback"
            android:textSize="12sp"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/black"
            android:hint="Share your thoughts with other customers"
            android:inputType="text"
            android:visibility="gone"
            android:layout_marginBottom="56dp"/>

        <LinearLayout
            android:id="@+id/llStar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="visible">

            <ImageView
                android:id="@+id/ivEmoji1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_emoji_1" />

            <ImageView
                android:id="@+id/ivEmoji2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="25dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_emoji_2" />

            <ImageView
                android:id="@+id/ivEmoji3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="25dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_emoji_3" />

            <ImageView
                android:id="@+id/ivEmoji4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="25dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_emoji_4" />

            <ImageView
                android:id="@+id/ivEmoji5"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="25dp"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_emoji_5" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="35dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cornerRadius="5dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/back"
                android:textSize="14sp"
                app:fontFamily="@font/montserrat_semi_bold"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary"
                android:layout_marginEnd="5dp"
                android:textAllCaps="false"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/submit"
                android:layout_marginStart="5dp"
                app:cornerRadius="5dp"
                android:textSize="14sp"
                app:fontFamily="@font/montserrat_semi_bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:enabled="false"
                />

        </LinearLayout>

    </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end"
        android:elevation="8dp"
        app:cardElevation="13dp"
        android:layout_margin="10dp"
        app:cardCornerRadius="24dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:id="@+id/close"
            android:layout_margin="5dp"
            android:layout_gravity="center"
            app:tint="@color/black"
            android:src="@drawable/ic_baseline_close_24"/>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>