<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
   >

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="7dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="2"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center|top"
                android:background="@color/white"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/prodImage"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="2dp"
                    android:elevation="0dp"
                    android:src="@drawable/noimageavailable" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="3dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_pName"
                        android:layout_weight="1"
                        style="@style/boldFont"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:gravity="center|left"
                        android:text="Product Name"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/txt_close"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="4dp"
                        android:layout_gravity="left"
                        android:text=""
                        android:textColor="@color/white"
                        android:padding="2dp"
                        android:background="@drawable/ic_baseline_close_24"
                        android:textStyle="bold"
                        android:textSize="10sp"
                        android:elevation="1dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txt_pInfo"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginTop="2dp"
                    android:maxLines="3"
                    android:fontFamily="@font/montserrat_regular"
                    android:gravity="center|left"
                    android:textColor="@color/hintColor"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/txt_unitvalue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_toRightOf="@+id/txt_unit"
                    android:gravity="center|left"
                    android:paddingLeft="1dp"
                    android:text="kg"
                    android:textColor="@color/darkGrey"
                    android:textSize="14sp" />

                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:paddingLeft="10dp"
                    android:visibility="gone"
                    android:paddingRight="10dp"
                    android:layout_gravity="center|left"
                    android:layout_marginTop="5dp">

                    <TextView
                        android:id="@+id/txt_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:paddingLeft="1dp"
                        android:gravity="center|left"
                        android:textColor="@color/darkGrey"
                        android:textSize="14sp"/>
                    <!--                <ImageView-->
                    <!--                    android:id="@+id/dropdown"-->
                    <!--                    android:layout_width="10dp"-->
                    <!--                    android:layout_height="10dp"-->
                    <!--                    android:layout_marginTop="8dp"-->
                    <!--                    android:background="@drawable/ic_down_arrow"-->
                    <!--                    android:layout_alignParentRight="true"/>-->
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="2dp"
                    android:layout_weight="2"
                    android:weightSum="2">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom">
                            <TextView
                                android:id="@+id/currency_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                style="@style/boldFont"                                android:paddingRight="2dp"
                                android:text="@string/currency"
                                android:textColor="@color/colorPrimary"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/txt_Pprice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/boldFont"
                                android:textColor="@color/colorPrimary"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/txt_Pprice1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                style="@style/boldFont"
                                android:textColor="@color/colorPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txt_Pprice2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserrat_semibold"
                                android:text=""
                                android:textColor="@color/colorPrimary"
                                android:textSize="10sp" />

                            <TextView
                                android:visibility="gone"
                                android:id="@+id/txt_Mrp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:layout_gravity="center"
                                android:gravity="center|left"
                                android:text="Rs. 45"
                                android:textColor="@color/colorPrimary"
                                android:textSize="11sp"/>

                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="end|center">

                        <LinearLayout android:id="@+id/btn_Add"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:backgroundTint="@color/colorPrimary"
                            android:background="@drawable/rounded_shape"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:paddingLeft="10dp"
                                android:paddingRight="5dp"
                                android:layout_marginLeft="10dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:gravity="center"
                                android:text="ADD"
                                android:visibility="gone"
                                android:textColor="@color/white"
                                android:textSize="15sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:paddingLeft="6dp"
                                android:layout_marginRight="6dp"
                                android:drawableRight="@drawable/ic_plus"/>


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_addQuan"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/minus"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:paddingRight="3dp"
                                android:drawableTint="@color/lightGrey"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="6dp"
                                android:drawableRight="@drawable/ic_outline_remove_circle_outline_24" />


                            <TextView
                                android:id="@+id/txtQuan"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:paddingRight="2dp"
                                android:paddingLeft="2dp"
                                android:fontFamily="@font/montserrat_semibold"
                                android:gravity="center"
                                android:text="1"
                                android:textColorHint="@color/hintColor"
                                android:textColor="@color/darkGrey"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/plus"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:paddingLeft="3dp"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="8dp"
                                android:drawableRight="@drawable/ic_add" />
                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_noStock"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/white_trans1"
            >
            <TextView
                android:id="@+id/txt_close1"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="7dp"
                android:layout_gravity="right"
                android:layout_alignParentEnd="true"
                android:text=""
                android:textColor="@color/white"
                android:padding="2dp"
                android:background="@drawable/ic_baseline_close_24"
                android:textStyle="bold"
                android:textSize="10sp"
                android:elevation="1dp"/>

            <TextView
                android:id="@id/tvOutOfStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Out of stock"
                android:gravity="center"
                app:fontFamily="@font/montserrat_medium"
                android:layout_centerInParent="true"
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                />

            <TextView
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show alternatives"
                android:gravity="center"
                app:fontFamily="@font/montserrat_semi_bold"
                android:layout_centerInParent="true"
                android:layout_below="@+id/tvOutOfStock"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/aqua"
                />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>



</androidx.coordinatorlayout.widget.CoordinatorLayout>

