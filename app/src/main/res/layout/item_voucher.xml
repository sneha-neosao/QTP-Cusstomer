<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    android:background="@color/white"
    android:layout_marginStart="25dp"
    android:layout_marginEnd="25dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="21dp">


        <ImageView
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:src="@drawable/coins"
            android:layout_marginStart="30dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
           >
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/aqua"
            android:gravity="center"
            app:fontFamily="@font/montserrat_semibold"
            android:text="$200"
            android:textSize="35sp"

            />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#324763"
                app:fontFamily="@font/montserrat_semi_bold"
                android:text="Value Vouchers"
                android:gravity="center"
                android:textSize="12sp"

                />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="30dp"
            android:layout_marginStart="-2dp"
            android:src="@drawable/right_half_circle" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="5dp"
            android:layout_gravity="center"
            app:tint="@color/lightGrey"
            android:src="@drawable/dash_bg"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="30dp"
            android:layout_marginEnd="-2dp"
            android:src="@drawable/left_half_circle" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRedeemVoucher"
        android:layout_gravity="center"
        android:layout_width="250dp"
        android:layout_height="50dp"
        app:cornerRadius="22dp"
        android:text="Reedem Voucher"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:fontFamily="@font/montserrat_medium"
        android:layout_marginBottom="20dp"/>


</LinearLayout>

